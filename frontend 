<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>BizConnect — Networking Profissional para Empresários</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd',
              400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8',
              800: '#1e40af', 900: '#1e3a8a', 950: '#172554',
            },
            dark: { 800: '#1e293b', 900: '#0f172a', 950: '#020617' }
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="bg-slate-100 text-slate-800 antialiased">

  <!-- ==================== AUTH ==================== -->
  <div id="auth-screen" class="min-h-screen flex">
    <div class="hidden lg:flex lg:w-1/2 bg-gradient-to-br from-primary-900 via-primary-800 to-dark-900 text-white p-12 flex-col justify-between relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-20 left-10 w-72 h-72 bg-blue-400 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-indigo-500 rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-12 h-12 bg-white/20 backdrop-blur rounded-xl flex items-center justify-center">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <span class="text-2xl font-bold tracking-tight">BizConnect</span>
        </div>
        <h1 class="text-4xl font-bold leading-tight mb-4">Networking de qualidade<br>para empresários</h1>
        <p class="text-blue-100 text-lg max-w-md">Ambiente seguro e profissional para troca de informações, oportunidades de negócio e colaboração entre líderes empresariais.</p>
      </div>
      <div class="relative z-10 space-y-4">
        <div class="flex items-center gap-3 text-blue-100"><div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-sm">✓</div><span>Verificação de identidade empresarial</span></div>
        <div class="flex items-center gap-3 text-blue-100"><div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-sm">✓</div><span>Mensagens criptografadas e privadas</span></div>
        <div class="flex items-center gap-3 text-blue-100"><div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-sm">✓</div><span>Oportunidades de negócio reais</span></div>
      </div>
    </div>

    <div class="w-full lg:w-1/2 flex items-center justify-center p-6 sm:p-12">
      <div class="w-full max-w-md">
        <div class="lg:hidden flex items-center gap-2 mb-8 justify-center">
          <div class="w-10 h-10 bg-primary-700 rounded-xl flex items-center justify-center text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <span class="text-xl font-bold text-primary-900">BizConnect</span>
        </div>

        <div class="flex border-b border-slate-200 mb-8">
          <button id="tab-login" onclick="switchAuthTab('login')" class="flex-1 py-3 text-center font-semibold text-primary-700 border-b-2 border-primary-600">Entrar</button>
          <button id="tab-register" onclick="switchAuthTab('register')" class="flex-1 py-3 text-center font-medium text-slate-500 border-b-2 border-transparent">Cadastrar</button>
        </div>

        <!-- Login -->
        <div id="form-login" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">E-mail</label>
            <input type="email" value="carlos.silva@empresa.com.br" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Senha</label>
            <input type="password" value="••••••••" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" class="rounded border-slate-300 text-primary-600"><span class="text-slate-600">Lembrar de mim</span></label>
            <button onclick="showRecover()" class="text-primary-600 hover:text-primary-700 font-medium">Esqueci a senha</button>
          </div>
          <button onclick="doLogin()" class="w-full bg-primary-700 hover:bg-primary-800 text-white font-semibold py-3.5 rounded-xl transition shadow-lg shadow-primary-700/25">Entrar na plataforma</button>
          <p class="text-center text-sm text-slate-500">Demo: clique em "Entrar" para acessar</p>
        </div>

        <!-- Register -->
        <div id="form-register" class="space-y-4 hidden">
          <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-sm font-medium text-slate-700 mb-1.5">Nome</label><input type="text" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none" placeholder="João"></div>
            <div><label class="block text-sm font-medium text-slate-700 mb-1.5">Sobrenome</label><input type="text" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none" placeholder="Silva"></div>
          </div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1.5">E-mail corporativo</label><input type="email" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none" placeholder="voce@suaempresa.com.br"></div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1.5">Telefone</label><input type="tel" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none" placeholder="(11) 99999-9999"></div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1.5">CNPJ da empresa</label><input type="text" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none" placeholder="00.000.000/0001-00"></div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Cargo</label>
            <select class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none bg-white">
              <option>CEO / Fundador</option><option>Diretor</option><option>Sócio</option><option>Gerente / Gestor</option><option>Investidor</option><option>Consultor</option>
            </select>
          </div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1.5">Senha</label><input type="password" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none" placeholder="Mínimo 8 caracteres"></div>
          <button onclick="doRegister()" class="w-full bg-primary-700 hover:bg-primary-800 text-white font-semibold py-3.5 rounded-xl transition shadow-lg shadow-primary-700/25">Criar conta</button>
          <p class="text-xs text-slate-500 text-center">Ao se cadastrar, você concorda com os Termos de Uso e Política de Privacidade (LGPD).</p>
        </div>

        <!-- Recover -->
        <div id="form-recover" class="space-y-5 hidden">
          <h3 class="text-lg font-semibold text-slate-900">Recuperar senha</h3>
          <p class="text-sm text-slate-500">Informe seu e-mail e enviaremos um link de recuperação.</p>
          <div><label class="block text-sm font-medium text-slate-700 mb-1.5">E-mail</label><input type="email" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-primary-500 outline-none" placeholder="seu@email.com"></div>
          <button onclick="sendRecover()" class="w-full bg-primary-700 hover:bg-primary-800 text-white font-semibold py-3.5 rounded-xl transition">Enviar link</button>
          <button onclick="switchAuthTab('login')" class="w-full text-slate-600 text-sm font-medium py-2">Voltar ao login</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== APP ==================== -->
  <div id="app-screen" class="hidden min-h-screen flex flex-col pb-16 lg:pb-0">
    <!-- Top Navbar -->
    <header class="bg-white border-b border-slate-200 h-14 sm:h-16 flex items-center justify-between px-3 sm:px-6 sticky top-0 z-40 shadow-sm">
      <div class="flex items-center gap-3">
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-slate-100">
          <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 sm:w-9 sm:h-9 bg-primary-700 rounded-lg flex items-center justify-center text-white">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <span class="font-bold text-primary-900 text-lg hidden sm:block">BizConnect</span>
        </div>
      </div>

      <div class="flex-1 max-w-xl mx-2 sm:mx-4 hidden md:block">
        <div class="relative cursor-pointer" onclick="openSearch()">
          <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" readonly placeholder="Buscar empresários, empresas, segmentos..." class="w-full pl-10 pr-4 py-2.5 bg-slate-100 border-0 rounded-xl text-sm cursor-pointer">
        </div>
      </div>

      <div class="flex items-center gap-1 sm:gap-2">
        <button onclick="openSearch()" class="md:hidden p-2 rounded-lg hover:bg-slate-100 text-slate-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
        <button onclick="showPage('notifications')" class="relative p-2 rounded-lg hover:bg-slate-100 text-slate-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          <span id="notif-badge" class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full"></span>
        </button>
        <button onclick="showPage('messages')" class="relative p-2 rounded-lg hover:bg-slate-100 text-slate-600 hidden sm:block">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          <span class="absolute top-1 right-1 w-4 h-4 bg-primary-600 text-white text-[10px] font-bold rounded-full flex items-center justify-center">3</span>
        </button>
        <div class="flex items-center gap-2 pl-2 border-l border-slate-200 cursor-pointer" onclick="showPage('profile')">
          <img src="https://ui-avatars.com/api/?name=Carlos+Silva&background=1e40af&color=fff&size=40" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full ring-2 ring-primary-100" alt="">
          <div class="hidden sm:block text-left">
            <p class="text-sm font-semibold text-slate-800 leading-tight">Carlos Silva</p>
            <p class="text-xs text-slate-500">CEO • TechBrasil</p>
          </div>
        </div>
      </div>
    </header>

    <div class="flex flex-1 overflow-hidden">
      <!-- Sidebar -->
      <aside id="sidebar" class="w-64 bg-dark-900 text-slate-300 flex-shrink-0 flex flex-col fixed lg:static inset-y-0 left-0 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-200 pt-14 lg:pt-0">
        <nav class="flex-1 py-4 px-3 space-y-1 overflow-y-auto scrollbar-thin">
          <button onclick="showPage('feed')" class="sidebar-item active w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="feed">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
            Feed
          </button>
          <button onclick="showPage('messages')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="messages">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            Mensagens <span class="ml-auto bg-primary-600 text-white text-xs font-bold px-2 py-0.5 rounded-full">3</span>
          </button>
          <button onclick="showPage('network')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="network">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            Networking
          </button>
          <button onclick="showPage('communities')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="communities">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Comunidades
          </button>
          <button onclick="showPage('opportunities')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="opportunities">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Oportunidades
          </button>
          <button onclick="showPage('notifications')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="notifications">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
            Notificações
          </button>
          <button onclick="showPage('profile')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="profile">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Meu Perfil
          </button>
          <button onclick="showPage('settings')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="settings">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Configurações
          </button>

          <button onclick="showPage('matchmaking')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="matchmaking">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Matchmaking
          </button>
          <button onclick="showPage('indications')" class="sidebar-item w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 transition" data-page="indications">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.4